# --- Core ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Optional: better voice transcription (falls back to a stub if unset) ---
OPENAI_API_KEY=

# --- Free voice transcription via Groq Whisper (get key at console.groq.com, no credit card) ---
GROQ_API_KEY=

# --- Optional: richer news (falls back to yfinance news if unset) ---
NEWSAPI_KEY=

# --- SEC EDGAR requires a descriptive User-Agent per SEC's fair-use policy ---
SEC_USER_AGENT="Financial Assistant contact@example.com"

# --- Storage ---
DATABASE_URL=sqlite:///./financial_assistant.db
DOCUMENTS_DIR=./data/documents

# --- Google integrations (optional, OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
